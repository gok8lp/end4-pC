#!/usr/bin/python3 -I
# kisayol-rehberi — Super+H: sağ alttan kayarak açılan Hyprland kısayol öğretici (GTK3 + gtk-layer-shell).
# Arka planda hazır bekler, SIGUSR1 ile açılır/kapanır (kisayol-ac). Arama kutusu, ok tuşlarıyla seçim,
# seçili kısayol için tuş animasyonu; Enter / çift tık kısayolu gerçekten uygular (ydotool ile tuşlara basar).
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

HOME = Path.home()
RENK = HOME / ".local/state/quickshell/user/generated/colors.json"
SCHEME = HOME / ".local/state/caelestia/scheme.json"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PIDFILE = RUN / "kisayol-rehberi.pid"
YDOTOOL_SOCK = RUN / ".ydotool_socket"

# Evdev tuş kodları (fiziksel tuşlar; düzenden bağımsız basılır)
MOD = {"Super": 125, "Ctrl": 29, "Alt": 56, "Shift": 42}
TUS = {**{c: k for c, k in zip("qwertyuiop", range(16, 26))}, **{c: k for c, k in zip("asdfghjkl", range(30, 39))},
       **{c: k for c, k in zip("zxcvbnm", range(44, 51))}, **{str(i): 1 + i for i in range(1, 10)}, "0": 11,
       "Space": 57, "Tab": 15, "Print": 99, "Delete": 111, "Esc": 1, "←": 105, "→": 106, "↑": 103, "↓": 108,
       "PgUp": 104, "PgDn": 109, "F1": 59, "F10": 68, "F11": 87, "F12": 88, "-": 12, "=": 13, ",": 51, ".": 52, "*": 13}

