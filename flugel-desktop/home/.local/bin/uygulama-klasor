#!/usr/bin/python3 -I
# uygulama-klasor — Super+A: GNOME tarzı, klasörlü tam ekran uygulama ızgarası (GTK3 + gtk-layer-shell).
# Arka planda hazır bekler; SIGUSR1 ile açılır/kapanır (izgara-ac). Esc ya da boş alana tıklama kapatır.
# Klasörler ızgaranın içindedir (kategori başına); yazınca bütün uygulamalarda arar.
# Renkler Caelestia'nın ~/.local/state/caelestia/scheme.json şemasından, her açılışta değiştiyse yenilenir.
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("Pango", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

try:
    import cairo
except ImportError:  # önizleme kalitesi için isteğe bağlı
    cairo = None

HOME = Path.home()
SCHEME = HOME / ".local/state/caelestia/scheme.json"
STATE = HOME / ".local/state/uygulama-klasor"
KULLANIM = STATE / "kullanim.json"
PINLER = STATE / "pinler.json"
PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "uygulama-klasor.pid"
APP_DIRS = [HOME / ".local/share/applications", Path("/usr/share/applications"),
            HOME / ".local/share/flatpak/exports/share/applications",
            Path("/var/lib/flatpak/exports/share/applications")]

# Klasörler (sıra ızgaradaki sıradır). İlk eşleşen kategori kazanır.
KLASORLER = [
    ("Sunucu", "network-server", None),
    ("Medya", "applications-multimedia", {"AudioVideo", "Audio", "Video", "Player"}),
    ("Oyunlar", "applications-games", {"Game"}),
    ("İnternet", "applications-internet", {"Network", "WebBrowser", "Email", "Chat", "InstantMessaging"}),
    ("Ofis", "applications-office", {"Office", "WordProcessor", "Spreadsheet", "Presentation"}),
    ("Grafik", "applications-graphics", {"Graphics", "Photography", "2DGraphics", "RasterGraphics"}),
    ("Geliştirme", "applications-development", {"Development", "IDE", "TextEditor"}),
    ("Sistem", "applications-system", {"System", "Settings", "Monitor", "TerminalEmulator", "PackageManager"}),
    ("Araçlar", "applications-utilities", {"Utility", "Accessories", "FileManager", "Archiving"}),
]
TEK_UYGULAMA_KLASORDE = False  # bir klasörde tek uygulama varsa ızgaraya çıkar (GNOME gibi)


def sunucu_mu(app):
    f = app.get_filename() or ""
    return os.path.basename(f).startswith("flugel-") or "flugelserver" in (app.get_commandline() or "")


def klasor_bul(app):
    if sunucu_mu(app):
        return "Sunucu"
    cats = set((app.get_categories() or "").split(";")) - {""}
    for ad, _, eslesen in KLASORLER:
        if eslesen and cats & eslesen:
            return ad
    return None


def uygulamalar():
    gorulen, liste = set(), []
    for a in Gio.AppInfo.get_all():
        if not isinstance(a, Gio.DesktopAppInfo) or not a.should_show():
            continue
        if a.get_id() in gorulen:
            continue
        gorulen.add(a.get_id())
        liste.append(a)
    liste.sort(key=lambda a: a.get_display_name().casefold())
    return liste


END4_RENK = HOME / ".local/state/quickshell/user/generated/colors.json"


def renkler():
    # Etkin arayüz end4-pC ise onun Material renkleri (snake_case → camelCase, '#' yok); yoksa Caelestia şeması
    try:
        d = json.loads(END4_RENK.read_text())
        renk = {}
        for k, v in d.items():
            if isinstance(v, str) and v.startswith("#") and len(v) >= 7:
                parcalar = k.split("_")
                renk[parcalar[0] + "".join(p.title() for p in parcalar[1:])] = v[1:7]
        if renk:
            return renk, d.get("mode") == "light" or False
    except (OSError, ValueError):
        pass
    try:
        d = json.loads(SCHEME.read_text())
        return d["colours"], d.get("mode") == "light"
    except (OSError, ValueError, KeyError):
        return {}, False


def rgba(c, ad, yedek, a):
    h = c.get(ad, yedek)
    return f"rgba({int(h[0:2], 16)},{int(h[2:4], 16)},{int(h[4:6], 16)},{a})"




def json_oku(yol, varsayilan):
    try:
        return json.loads(yol.read_text())
    except (OSError, ValueError):
        return varsayilan


def json_yaz(yol, veri):
    try:
        yol.parent.mkdir(parents=True, exist_ok=True)
        yol.write_text(json.dumps(veri))
    except OSError as e:
        print("yazılamadı:", yol, e, file=sys.stderr)


