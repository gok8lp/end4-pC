}
yardim() { cat <<H
kilavuz $VER - Türkçe terminal rehberi
  kilavuz                  fzf varsa etkileşimli, yoksa tam liste
  kilavuz --ara KELİME     başlık/açıklama/örnekte ara (--ara a b: hepsi geçmeli)
  kilavuz --kategori AD    bir kategoriyi göster (örn. docker, git, ssh)
  kilavuz --kategoriler    kategorileri listele
  kilavuz --liste          her şeyi yazdır
  kilavuz --fzf            fzf ile gez
H
}
fmt() { # stdin: kategori|baslik|aciklama|ornek
  local b="" r="" d=""; [ -t 1 ] && { b=$'\e[1;36m'; d=$'\e[2m'; r=$'\e[0m'; }
  local k son=""
  while IFS='|' read -r k t a o; do
    if [ "$k" != "$son" ]; then printf '\n%s== %s ==%s\n' "$b" "$k" "$r"; son=$k; fi
    printf '  %s%s%s\n      %s\n' "$b" "$t" "$r" "$a"
    [ -n "$o" ] && printf '      %sörnek:%s %b\n' "$d" "$r" "$o"
  done | tr "\001" "|"
}
# Ayrıştırma: örnek alanı '|' içerebildiği için ilk üç '|' ayırıcıdır; fazlası örneğe aittir.
temiz() { veri | sed "s/¦/\x01/g" | awk -F'|' '{k=$1;t=$2;a=$3;o=$4; for(i=5;i<=NF;i++)o=o"|"$i; print k"|"t"|"a"|"o}'; }
cmd="${1:-}"
case "$cmd" in
  -h|--yardim|--help) yardim ;;
  --liste) temiz | fmt ;;
  --kategoriler) temiz | cut -d'|' -f1 | uniq ;;
  --kategori|-k) [ -z "${2:-}" ] && { echo "Kategori adı gerekli"; exit 1; }
     q="${2,,}"; temiz | awk -F"|" -v q="$q" 'index(tolower($1),q)' | fmt ;;
  --ara|-a) shift; [ $# -eq 0 ] && { echo "Aranacak kelime gerekli"; exit 1; }
     out=$(temiz); for w in "$@"; do out=$(printf '%s\n' "$out" | grep -iF -- "$w"); done
     if [ -z "$out" ]; then echo "Sonuç yok: $*"; exit 1; fi
     printf '%s\n' "$out" | fmt ;;
  --fzf|"")
     if command -v fzf >/dev/null && [ -t 1 ] && [ -t 0 ]; then
        temiz | awk -F'|' '{printf "%-18s %-34s %s   [örnek: %s]\n",$1,$2,$3,$4}' | tr '\001' '|' | fzf --prompt='kilavuz> ' --header='yaz ve ara, ESC çık' --no-sort
     else temiz | fmt; fi ;;
  *) echo "Bilinmeyen seçenek: $cmd"; yardim; exit 1 ;;
esac
