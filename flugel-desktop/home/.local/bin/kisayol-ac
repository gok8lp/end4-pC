#!/bin/bash
# kisayol-ac — Super+H: kısayol rehberini aç/kapat. Hazırsa sinyal gönderir, değilse başlatır. "--baslat": açılışta hazırla.
pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/kisayol-rehberi.pid" 2>/dev/null)
if [ -n "$pid" ] && grep -q kisayol-rehberi "/proc/$pid/cmdline" 2>/dev/null; then
  [ "$1" = --baslat ] || exec kill -USR1 "$pid"
  exit 0
fi
if [ "$1" = --baslat ]; then setsid -f ~/.local/bin/kisayol-rehberi >/dev/null 2>&1
else setsid -f ~/.local/bin/kisayol-rehberi --goster >/dev/null 2>&1; fi
